# ─────────────────────────────────────────────────────────────
# Root env reference. Copy the relevant block into:
#   backend/.env           -> backend runtime
#   frontend/.env          -> Vite runtime (VITE_* only)
#   Supabase dashboard     -> Edge Function secrets (last block)
# ─────────────────────────────────────────────────────────────

# ── Backend (backend/.env) ──
PORT=4000
FRONTEND_URL=http://localhost:5173  

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # server only — bypasses RLS

# AES-256-GCM key for broker-credential encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROKER_ENCRYPTION_KEY=64_HEX_CHARS_HERE

# Shared secret guarding /internal/* job endpoints (Supabase cron edge
# functions send it as the x-cron-secret header). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=SOME_RANDOM_HEX

# ── Optional instrument-cache behaviour (spec 3.3) ──
# On backend boot, auto-run scrip-master sync in the background when the cache
# is missing/stale — removes the manual instrument-sync curl on fresh setups.
#   stale = sync if empty OR older than INSTRUMENT_STALE_HOURS (default)
#   empty = sync only when the table is empty
#   off   = never sync on boot (daily 06:00 IST pg_cron only)
#INSTRUMENT_BOOT_SYNC=stale
#INSTRUMENT_STALE_HOURS=20
# Exchanges cached by instrument sync (comma-separated exch_seg values):
#INSTRUMENT_SYNC_EXCH_SEG=NSE,BSE,NFO

# ── Optional notification channels (spec 3.9) ──
# Telegram: create a bot via @BotFather, paste its token. Users link their own
# chat ID from the notification-preferences screen. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
# Email: URL that receives POST { userId, type, title, body, at } — typically
# a Supabase Edge Function that resolves the user's email (auth admin) and
# sends via a transactional provider (Resend/SES/…). Leave empty to disable.
NOTIFY_EMAIL_WEBHOOK_URL=

# ── Frontend (frontend/.env) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_API_BASE_URL=http://localhost:4000

# ── Supabase Edge Function secrets (supabase secrets set ...) ──
CRON_SECRET=SAME_VALUE_AS_BACKEND          # must match backend/.env CRON_SECRET
INTERNAL_API_BASE_URL=https://YOUR_BACKEND_HOST   # where /internal/jobs/* is reachable
